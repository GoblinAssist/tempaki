# Copy this file to .env (repo root, git-ignored) and fill in your own values.
JIRA_URL=https://your-domain.atlassian.net
JIRA_USER=you@example.com
# Create a Jira API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=your-jira-api-token
# In Jira, open Tempo > Settings > API integration to create a Tempo API token:
TEMPO_TOKEN=your-tempo-api-token
